Private Function TextField(data As JSONItem, key As String) As String
    Return data.Value(key).AsString().Or("")
End Function

Private Function NumberField(data As JSONItem, key As String) As Integer
    Dim item As JSONItem = data.Value(key)
    If item.IsNull() Then Return 0
    If Not item.IsNumber() Then Throw New InvalidArgumentException("Expected a numeric Forgejo identifier")
    Dim number As Double = item.AsNumber().Value
    If number <> number Or number < 0.0 Or number > 9007199254740991.0 Then Throw New InvalidArgumentException("Forgejo identifier exceeds JSON exact integer range")
    If number <> Math.Floor(number) Then Throw New InvalidArgumentException("Expected an integer Forgejo identifier")
    Return number
End Function

Private Sub NoControls(value As String)
    For Each character As String In String.Chars(value)
        Dim code As Integer = String.Asc(character)
        If code < 32 Or code = 127 Then Throw New InvalidArgumentException("Control character is not allowed")
    Next
End Sub

' Percent-encode exactly one UTF-8 path segment. Dots and slash cannot change routes.
Public Function EncodeForgejoSegment(value As String) As String
    If value = "" Or value = "." Or value = ".." Then Throw New InvalidArgumentException("A nonempty path segment is required")
    NoControls(value)
    Dim encoded As String = ""
    Dim digits As String = "0123456789ABCDEF"
    Dim data As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To data.Count - 1
        Dim n As Integer = data.Item(i)
        If (n >= 65 And n <= 90) Or (n >= 97 And n <= 122) Or (n >= 48 And n <= 57) Or n = 45 Or n = 46 Or n = 95 Or n = 126 Then
            encoded += String.Chr(n)
        Else
            encoded += "%" + String.Substring(digits, n \ 16, 1) + String.Substring(digits, n Mod 16, 1)
        End If
    Next
    Return encoded
End Function

Public Class ForgejoAPIException Inherits Exception
    Public Property HTTPStatus As Integer
    Public Property RequestID As String
    Public Property RateLimitRemaining As String
    Public Property RateLimitReset As String
    Public Property RetryAfter As String

    Public Sub Constructor(message As String, status As Integer, requestID As String, remaining As String, resetValue As String, retry As String)
        Super.Constructor(message, status)
        Me.HTTPStatus = status
        Me.RequestID = requestID
        Me.RateLimitRemaining = remaining
        Me.RateLimitReset = resetValue
        Me.RetryAfter = retry
    End Sub
End Class

Public Class ForgejoRepository
    Public Property RawJSON As JSONItem
    Public Property ID As Integer
    Public Property Name As String
    Public Property FullName As String
    Public Property Description As String
    Public Property HTMLURL As String
    Public Property DefaultBranch As String
    Public Property IsPrivate As Boolean

    Public Sub Constructor(data As JSONItem)
        If data = Nil Then Throw New InvalidArgumentException("JSON object is required")
        If Not data.IsObject() Then Throw New InvalidArgumentException("JSON object is required")
        Me.RawJSON = data
        Me.ID = NumberField(data, "id")
        Me.Name = TextField(data, "name")
        Me.FullName = TextField(data, "full_name")
        Me.Description = TextField(data, "description")
        Me.HTMLURL = TextField(data, "html_url")
        Me.DefaultBranch = TextField(data, "default_branch")
        Me.IsPrivate = data.Value("private").AsBoolean().Or(False)
    End Sub
End Class

